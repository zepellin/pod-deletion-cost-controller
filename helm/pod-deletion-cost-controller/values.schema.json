{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "syncInterval": {
          "type": "string",
          "minLength": 1
        },
        "busyCPUThreshold": {
          "type": "string",
          "minLength": 1
        },
        "busyCost": { "type": "integer" },
        "idleCost": { "type": "integer" },
        "noMetricsCost": { "type": "integer" },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "labelSelector"],
            "properties": {
              "namespace": { "type": "string", "minLength": 1 },
              "labelSelector": { "type": "string", "minLength": 1 },
              "containers": {
                "type": "array",
                "items": { "type": "string" }
              },
              "strategy": {
                "type": "string",
                "enum": ["threshold", "escalating"]
              },
              "escalatingStep": { "type": "integer", "minimum": 1 },
              "escalatingMax": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
